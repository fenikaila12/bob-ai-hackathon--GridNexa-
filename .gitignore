# =============================================================================
# HACKATHON SUBMISSION — .gitignore
# =============================================================================
# Never commit secrets, credentials, temporary files, or large binary files.

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.nuxt/
.output/
.cache/

# ── Java / Maven / Gradle ─────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
.gradle/

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/
*.exe

# ── Rust ──────────────────────────────────────────────────────────────────────
target/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Large Media Files ─────────────────────────────────────────────────────────
# Use demo-video-link.txt instead of committing the actual video.
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv
demo/*.webm

# ── Logs & Temporary Data ─────────────────────────────────────────────────────
logs/
*.log
*.tmp
*.temp

# ── Docker ────────────────────────────────────────────────────────────────────
# Ignore local Docker volumes/data, but keep Docker configuration files.
docker-data/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup